# Server-only secrets: do NOT prefix these with NEXT_PUBLIC_
ADMIN_PASSWORD=replace-with-a-long-random-password-at-least-16-characters
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Public WhatsApp number used by customer-facing booking buttons
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_SITE_URL=https://your-live-site.vercel.app
